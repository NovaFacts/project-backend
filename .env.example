# ──────────────────────────────────────────────────────────────────────────────
# NovaFacts — Backend environment variables
#
# Copy this file to .env and fill in real values before running the stack.
# .env is listed in .gitignore and must NEVER be committed to version control.
#
# Usage (Docker Compose — recommended):
#   cp .env.example .env
#   # edit .env — fill in POSTGRES_PASSWORD and JWT_SECRET at minimum
#   docker compose up -d
#
# Usage (local, without Docker):
#   export POSTGRES_USER=postgres
#   export POSTGRES_PASSWORD=your_password_here
#   export JWT_SECRET=$(openssl rand -base64 48)
#   ./mvnw spring-boot:run
#
# The backend will REFUSE TO START if JWT_SECRET is not set.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# POSTGRES_USER defaults to "postgres" if not set; override here if needed.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ── JWT authentication ────────────────────────────────────────────────────────
# REQUIRED — no default exists. The application will not start without this.
# Generate a secure value with:
#   openssl rand -base64 48
# Use a different secret for each environment (dev, staging, production).
JWT_SECRET=replace_with_output_of_openssl_rand_base64_48

# OPTIONAL — token lifetime in milliseconds. Defaults to 86400000 (24 hours).
# JWT_EXPIRATION=86400000
