# ──────────────────────────────────────────────────────────────────────────────
# NovaFacts — Backend environment variables
#
# Copy this file to .env and fill in real values before running the stack.
# .env is listed in .gitignore and must NEVER be committed to version control.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your actual credentials
#   docker compose up -d          # Docker Compose reads .env automatically
#
# For local development WITHOUT Docker (./mvnw spring-boot:run), export the
# variables in your shell before running Maven:
#   export POSTGRES_PASSWORD=your_password_here
#   export POSTGRES_USER=postgres   # optional — defaults to "postgres"
#   ./mvnw spring-boot:run
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL credentials
# POSTGRES_USER defaults to "postgres" if not set; override here if needed.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
